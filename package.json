{
  "name": "aendi-dog",
  "private": true,
  "version": "0.2.17",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc",
    "sim": "tsx scripts/sim.ts",
    "android": "npm run build && npm run icon:install && npx cap sync android && npm run android:offline && npx cap open android",
    "android:offline": "node scripts/android-offline.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon:build": "node scripts/make-icon.mjs",
    "icon:install": "node scripts/install-icon.mjs",
    "feature:build": "tsx scripts/make-feature.ts",
    "screenshots:build": "tsx scripts/make-screenshots.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@fontsource/atkinson-hyperlegible": "^5.0.0",
    "@fontsource/bricolage-grotesque": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
